# Build output
bin/
obj/
dist/

# Rider / VS
.idea/
*.user
*.suo
.vs/

# Test clips (local only — too large for git)
testclips/pristine/
# Everything in scratch is regenerated — copies plus write-engine temp artifacts
# (clip.mp4.<guid>.tmp, File.Replace's clip.mp4~RFxxxx.TMP) — but keep the dir itself
# (via .gitkeep) so a fresh clone has the path the tests expect.
testclips/scratch/*
!testclips/scratch/.gitkeep

# Test results
TestResults/

# Temp files from write engine and tooling
*.mp4.tmp
*.mp4.bak
*.tmp.*

# Claude Code and superpowers tooling state
.claude/
.superpowers/brainstorm/

# OS
.DS_Store
Thumbs.db
