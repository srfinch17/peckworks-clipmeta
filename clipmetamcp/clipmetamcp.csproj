<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Version is single-sourced from the repo-root VERSION file via Directory.Build.props. -->
    <!--
      PublishTrimmed must stay OFF (spec risk R4): the protocol layer uses reflection-based
      System.Text.Json, which trimming breaks silently. Do not enable trimming until the
      protocol DTOs move to a source-generated JsonSerializerContext.
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\clipmeta.core\clipmeta.core.csproj" />
  </ItemGroup>
</Project>
